# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore: los secretos NUNCA se suben al repo.
# En producción se configuran en Netlify: Site settings > Environment variables.

# --- Supabase (Dashboard > Project Settings > API) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La service_role key se salta la seguridad de filas: SOLO para el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta / WhatsApp Cloud API (developers.facebook.com > tu app) ---
# Token permanente del System User (no el temporal de 24h del panel de pruebas).
WHATSAPP_TOKEN=
# Id del número de teléfono (panel de WhatsApp > API Setup > Phone number ID).
WHATSAPP_PHONE_NUMBER_ID=
# App Secret (Settings > Basic > App Secret): valida la firma de los webhooks.
META_APP_SECRET=
# Token de verificación: lo INVENTAS tú y pones el mismo aquí y en el panel
# de Meta al configurar el webhook.
META_VERIFY_TOKEN=
